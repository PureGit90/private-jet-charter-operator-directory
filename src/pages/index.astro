---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESCRIPTION, CATEGORIES, DATA_DATE_LABEL, fmtUsd } from '../lib/site';
import { alpha, categoryStats } from '../lib/rates';

const listings = (await getCollection('listings')).sort(alpha);
const light = categoryStats(listings, 'light');
const withRates = listings.filter((l) => l.data.rates.length > 0).length;
const quoteOnly = listings.filter((l) => l.data.publishes === 'none').length;
const operators = listings.filter((l) => l.data.role === 'operator').length;

// Sample trip as published on evoJets' pricing page (listing: evojets), read 2026-10-03.
const rate = 3400, hours = 5;
const flight = rate * hours, fuel = 550, crew = 600, landing = 750;
const subtotal = flight + fuel + crew + landing;
const tax = subtotal * 0.075;
const total = subtotal + tax;
const usd = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Private jet charter providers read for ${SITE_NAME}`,
    itemListElement: listings.map((l, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: l.data.name,
      url: new URL(`/listings/${l.id}/`, Astro.site ?? 'https://example.com').toString(),
    })),
  },
];
---
<BaseLayout title={`${SITE_NAME}: What ${listings.length} Providers Publish`} description={`A ${fmtUsd(rate)} hourly rate became a ${usd(total)} invoice. Hourly rates, fees and broker or operator status for ${listings.length} private jet charter companies, each sourced to its own page.`} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>A {fmtUsd(rate)} hourly rate became a {usd(total)} invoice.</h1>
        <p>That is a sample trip one charter broker publishes on its own pricing page. This site reads what {listings.length} private jet charter providers publish about price, fees and who flies the plane, and lines it up with sources.</p>
        <p class="also">Light jets are published at {fmtUsd(light.min!)} to {fmtUsd(light.max!)} an hour across {light.providers} providers, and the pages do not always say what that number includes.</p>
        <p><a class="btn" href="/rates/">See the published rates</a></p>
      </div>
      <div class="invoice" aria-label="Sample charter invoice">
        <h2>Los Angeles to Aspen, round trip</h2>
        <p class="trip">Midsize jet, {hours} flight hours at {fmtUsd(rate)}, 2 days and 1 night</p>
        <dl>
          <div class="row"><dt>Flight time</dt><dd>{usd(flight)}</dd></div>
          <div class="row"><dt>Fuel surcharge</dt><dd>{usd(fuel)}</dd></div>
          <div class="row"><dt>Crew fees</dt><dd>{usd(crew)}</dd></div>
          <div class="row"><dt>Landing fees</dt><dd>{usd(landing)}</dd></div>
          <div class="row sub"><dt>Subtotal</dt><dd>{usd(subtotal)}</dd></div>
          <div class="row"><dt>Federal excise tax, 7.5%</dt><dd>{usd(tax)}</dd></div>
          <div class="row total"><dt>Total</dt><dd>{usd(total)}</dd></div>
        </dl>
        <p class="src">Sample trip as published by <a href="/listings/evojets/">evoJets</a>, read {DATA_DATE_LABEL}. Not a quote.</p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <ul class="facts">
      <li><strong>{listings.length}</strong><span>providers read</span></li>
      <li><strong>{withRates}</strong><span>publish an hourly figure we could tabulate</span></li>
      <li><strong>{quoteOnly}</strong><span>show no charter price on the pages we read</span></li>
      <li><strong>{operators}</strong><span>describe flying their own fleet</span></li>
    </ul>

    <h2>Where to start</h2>
    <ul class="paths">
      <li>
        <h3><a href="/rates/">Published rates</a></h3>
        <p>Hourly rates by aircraft type, each labeled as a base rate, an all-in figure or a planning range, with the page it came from.</p>
      </li>
      <li>
        <h3><a href="/fees/">Fees on top</a></h3>
        <p>Which providers name the 7.5% excise tax, the per-passenger segment fee, daily minimums and positioning, checked against the FAA's 2026 rates.</p>
      </li>
      <li>
        <h3><a href="/broker-vs-operator/">Broker or operator</a></h3>
        <p>Most consumer charter brands call themselves brokers. What each one says it is, and five questions that name the operator before you pay.</p>
      </li>
      {CATEGORIES.map((c) => (
        <li>
          <h3><a href={`/category/${c.slug}/`}>{c.name}</a></h3>
          <p>{listings.filter((l) => l.data.category === c.name).length} providers. {c.intro.split('. ')[0]}.</p>
        </li>
      ))}
    </ul>

    <div class="panel">
      <h2>What this site is not</h2>
      <p>It is not a quote tool, and it does not rank providers. Published rates are marketing figures read from each provider's pages on {DATA_DATE_LABEL}. We did not request quotes, call providers or fly with them. Your trip will price differently. Read <a href="/how-we-compare/">how we compare</a> for the method and its limits, and <a href="/about/">who runs this site</a>.</p>
    </div>
  </div>
</BaseLayout>
