---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_EMAIL, DATA_DATE_LABEL } from '../lib/site';

// One entry per correction: { date: 'YYYY-MM-DD', listing: 'provider name', what: 'what changed and why' }.
const log: { date: string; listing: string; what: string }[] = [
  { date: '2026-11-05', listing: 'Stratos Jets', what: 'Its pricing page was rebuilt: a new eight-row hourly table ($5,648 to $22,910, up from $4,000 to $18,500), quotes now described as all-in, and the itemized landing, handling, fuel and segment fee amounts removed. Listing and the fees page updated.' },
  { date: '2026-11-05', listing: 'Jet Partners', what: 'Every planning range was lowered (light jets now $4,750 to $7,000 an hour, were $6,800 to $9,900) and its worked Teterboro to Miami example is now $14,000 to $27,000. Listing updated.' },
];
---
<BaseLayout title="Corrections and Updates | Charter Prices Compared" description="How to report a wrong or out-of-date price on this site, how we check it, and a log of every correction we have made.">
  <div class="wrap prose">
    <p class="crumbs"><a href="/">Home</a> / Corrections</p>
    <h1>Corrections and updates</h1>
    <p class="lead">Published prices change, and providers rewrite their pages. If something here is wrong or out of date, we want to know.</p>

    <h2>How to report a problem</h2>
    <p>{CONTACT_EMAIL ? <>Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></> : <>Write to us</>} with the page address, what is wrong, and a link to where the provider says otherwise. Providers can do the same for their own listing.</p>

    <h2>What we do with it</h2>
    <ol>
      <li>We open the provider's own page and check the figure or statement.</li>
      <li>If the page now says something different, we update the listing, change its "read" date, and add a line to the log below.</li>
      <li>If we cannot confirm the change on a public page, we say so on the listing and do not guess.</li>
    </ol>

    <h2>How often we re-read</h2>
    <p>Every listing shows the date we read it. We re-read every provider's pages once a month, and sooner when a reader reports a change. The latest full read was {DATA_DATE_LABEL}.</p>

    <h2>Correction log</h2>
    {log.length === 0 ? (
      <p>No corrections yet. This log lists each one with its date and what changed.</p>
    ) : (
      <ul>{log.map((c) => <li><strong>{c.date}, {c.listing}:</strong> {c.what}</li>)}</ul>
    )}
  </div>
</BaseLayout>
